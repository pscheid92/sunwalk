{
    "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
    "files": {
        "includes": ["src/**/*.ts", "src/**/*.tsx", "*.json"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "semicolons": "always",
            "quoteStyle": "double",
            "trailingCommas": "none"
        }
    },
    "linter": {
        "rules": {
            "style": {
                "useConst": "off"
            }
        }
    }
}
